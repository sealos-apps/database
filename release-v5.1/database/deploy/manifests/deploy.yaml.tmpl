apiVersion: v1
kind: Namespace
metadata:
  labels:
    app: dbprovider-frontend
  name: dbprovider-frontend
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: dbprovider-frontend-config
  namespace: dbprovider-frontend
data:
  config.yaml: |-
    cloud:
      domain: "{{ .cloudDomain }}"
      desktopDomain: "{{ .cloudDomain }}"
      port: "{{ .cloudPort }}"
      disableHttps: false
    database:
      features:
        guide: {{ .guideEnabled }}
        showDocument: true
        fileImport: true
        logs: false
        kafka: true
        managedDb: false
      ui:
        customScripts: []
      storage:
        forcedClassName: ""
        maxSize: 300
      components:
        monitoring:
          url: "{{ .metricsUrl }}"
        alerting:
          url: "http://database-alert.sealos.svc:8000"
        billing:
          url: "{{ .billingUrl }}"
        logging:
          url: "{{ .vlogsBaseUrl }}"
        storage:
          url: "{{ .minioUrl }}"
          port: {{ .minioPort }}
          useSSL: true
          bucketName: "{{ .minioBucketName }}"
          accessKey: "{{ .minioAccessKey }}"
          secretKey: "{{ .minioSecretKey }}"
        eventAnalysis:
          fastGPTKey: ""
      migration:
        importDataImage: "{{ .migrateFileImage }}"
      backup:
        enabled: false
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: dbprovider-frontend
  namespace: dbprovider-frontend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: dbprovider-frontend
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 25%
      maxSurge: 25%
  template:
    metadata:
      labels:
        app: dbprovider-frontend
    spec:
      serviceAccountName: cluster-version-reader
      containers:
        - name: dbprovider-frontend
          securityContext:
            runAsNonRoot: true
            runAsUser: 1001
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - 'ALL'
          resources:
            limits:
              cpu: 2000m
              memory: 2048Mi
            requests:
              cpu: 10m
              memory: 128Mi
          # do not modify this image, it is used for CI/CD
          image: ghcr.io/sealos-apps/database/database-frontend:release-v5.1
          imagePullPolicy: Always
          volumeMounts:
            - name: dbprovider-frontend-volume
              mountPath: /app/data/config.yaml
              subPath: config.yaml
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: "app"
                  operator: In
                  values:
                  - dbprovider-frontend
              topologyKey: "kubernetes.io/hostname"
      volumes:
        - name: dbprovider-frontend-volume
          configMap:
            name: dbprovider-frontend-config
---
apiVersion: v1
kind: Service
metadata:
  labels:
    app: dbprovider-frontend
  name: dbprovider-frontend
  namespace: dbprovider-frontend
spec:
  ports:
    - name: http
      port: 3000
      protocol: TCP
      targetPort: 3000
  selector:
    app: dbprovider-frontend
