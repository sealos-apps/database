# Optional combined-installer overrides. Copy outside the package, edit, then:
# set -a; source /path/to/install.env; set +a; bash install.sh
# Unset options use the defaults below; this file is not loaded automatically.

# Database Helm release identity; preserve these when upgrading.
RELEASE_NAME=dbprovider-frontend
RELEASE_NAMESPACE=dbprovider-frontend
# Additional Database Helm arguments (space-separated).
HELM_OPTS=
HELM_OPTIONS=

# DataFlow Helm release identity; use the existing release when upgrading.
DATAFLOW_RELEASE_NAME=dataflow
DATAFLOW_NAMESPACE=dataflow-system
# Additional DataFlow Helm arguments, including explicit image overrides.
DATAFLOW_HELM_OPTS=
# Persistent DataFlow values location; recovered values may contain credentials.
DATAFLOW_USER_VALUES_DIR=/root/.sealos/cloud/values/apps/dataflow

# Empty reads sealos-system/sealos-config.data.cloudDomain for both services.
SEALOS_CLOUD_DOMAIN=

# Runtime image pins are generated in each package's image.env by
# scripts/prepare-bundle.sh using its image repository and tag arguments.
# DATAFLOW_IMAGE_REPOSITORY / DATAFLOW_IMAGE_TAG feed the DataFlow Helm image
# values; DATABASE_RUNTIME_IMAGE feeds Database's image value. The combined
# installer sources these pins, so inherited environment values cannot replace
# them. Use DATAFLOW_HELM_OPTS for an explicit DataFlow image override; change
# prepare-bundle.sh arguments to configure the packaged Database image.

# Database operator compatibility, installer input only (not a container env variable).
# Empty preserves Helm/user values: main profile defaults to 0.9, release-v5.1 to 0.8.
# Set 0.8 or 0.9 to match the cluster. Does not upgrade KubeBlocks or migrate data.
# Direct Helm override: --set-string dbproviderConfig.kubeblocksVersion=0.8
KUBEBLOCKS_VERSION=
