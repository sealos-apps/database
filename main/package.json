{
  "name": "database-workspace",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev-db": "pnpm -r --filter ./database  run dev",
    "gen:theme-typings": "pnpm chakra-cli tokens packages/ui/src/theme/theme.ts --out node_modules/.pnpm/node_modules/@chakra-ui/styled-system/dist/theming.types.d.ts",
    "postinstall": "pnpm run gen:theme-typings && pnpm run build-packages",
    "build-packages": "pnpm -r --filter './packages/*' run build",
    "build-database": "pnpm --filter ./database run build"
  },
  "workspaces": [
    "./packages/*",
    "./database"
  ],
  "devDependencies": {
    "@chakra-ui/cli": "^2.4.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.9",
    "prettier": "^2.8.8",
    "typescript": "^5.2.2"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "win32",
        "darwin",
        "current",
        "linuxmusl"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "musl"
      ]
    }
  },
  "packageManager": "pnpm@8.9.0",
  "engines": {
    "node": "20.20.2",
    "pnpm": "8.9.0"
  }
}
